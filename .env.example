# Deployment environment: development | staging | production.
# In production the server refuses to start without PASSWORD or OIDC_ISSUER.
APP_ENV=production

# Shared password for `jardin login --password`. Leave empty only when SSO is on.
PASSWORD=

# --- optional, shown with their defaults ---

# PORT=8420
# LOG_LEVEL=info
# DATA_DIR=/data

# Cross-origin callers. Empty denies every browser origin, which is what the
# single-container deployment wants: the SPA is served same-origin.
# CORS_ALLOWED_ORIGINS=

# SSO via Authentik (porte). Setting OIDC_ISSUER makes CLIENT_ID, CLIENT_SECRET
# and REDIRECT_URL mandatory. SSO_ONLY=true disables password login and requires
# OIDC_ISSUER.
# SSO_ONLY=false
# OIDC_ISSUER=https://porte.facile.studio/application/o/jardin/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://jardin.facile.studio/api/auth/oidc/callback
# OIDC_SUCCESS_URL=https://jardin.facile.studio/auth/callback

# Log shipping to Journal. Both must be set for anything to be shipped.
# JOURNAL_URL=https://journal.facile.studio/api
# JOURNAL_TOKEN=

# Bus (Antenne). Setting ANTENNE_URL is enough to turn emitting on. These
# override .settings.json, so the instance is configured by its deployment and
# not by whoever last opened the dashboard; the pinned fields show read-only
# there. Leave unset to configure the bus from the UI instead.
# ANTENNE_URL=https://antenne.facile.studio
# ANTENNE_SECRET=
# ANTENNE_USER_EMAIL=you@facile.studio

# Semantic memory search. Setting OLLAMA_URL is enough to turn it on; leave it
# unset and search stays lexical-only, which it also falls back to whenever the
# model is unreachable. Setting any of the other three without OLLAMA_URL is
# refused rather than silently ignored. VECTOR_STORE=qdrant needs QDRANT_URL.
# Semantic memory search is ON by default: docker-compose.yml points these at
# the shared ollama/qdrant sidecars, so a standard deploy needs nothing here.
# Set OLLAMA_URL to another host to use your own ollama, or to an EMPTY value
# to turn semantic search off and keep memory search lexical-only.
OLLAMA_URL=
EMBED_MODEL=
VECTOR_STORE=
QDRANT_URL=

# Those two hostnames only resolve once the container has joined the shared
# `facile-ai` docker network, where the standalone ollama and qdrant containers
# live. `scripts/ai-sidecars.sh` creates all three and pulls the model; run it
# once on the host before the first `docker compose up`, or compose fails on the
# missing external network. See docs/deployment.md.
