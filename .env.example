# Deployment environment: development | staging | production.
# In production the server refuses to start without PASSWORD or OIDC_ISSUER.
APP_ENV=production

# Shared password for `jardin login --password`. Leave empty only when SSO is on.
PASSWORD=

# --- optional, shown with their defaults ---

# PORT=8420
# LOG_LEVEL=info
# DATA_DIR=/data

# Cross-origin callers. Empty denies every browser origin, which is what the
# single-container deployment wants: the SPA is served same-origin.
# CORS_ALLOWED_ORIGINS=

# SSO via Authentik (porte). Setting OIDC_ISSUER makes CLIENT_ID, CLIENT_SECRET
# and REDIRECT_URL mandatory. SSO_ONLY=true disables password login and requires
# OIDC_ISSUER.
# SSO_ONLY=false
# OIDC_ISSUER=https://porte.facile.studio/application/o/jardin/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://jardin.facile.studio/api/auth/oidc/callback
# OIDC_SUCCESS_URL=https://jardin.facile.studio/auth/callback

# Log shipping to Journal. Both must be set for anything to be shipped.
# JOURNAL_URL=https://journal.facile.studio/api
# JOURNAL_TOKEN=

# Bus (Antenne). Setting ANTENNE_URL is enough to turn emitting on. These
# override .settings.json, so the instance is configured by its deployment and
# not by whoever last opened the dashboard; the pinned fields show read-only
# there. Leave unset to configure the bus from the UI instead.
# ANTENNE_URL=https://antenne.facile.studio
# ANTENNE_SECRET=
# ANTENNE_USER_EMAIL=you@facile.studio
