# Deployment environment: development | staging | production.
# In production the server refuses to start without PASSWORD or OIDC_ISSUER.
APP_ENV=production

# Shared password for `mycelium login --password`. Leave empty only when SSO is on.
PASSWORD=

# --- optional, shown with their defaults ---

# PORT=8420
# LOG_LEVEL=info
# DATA_DIR=/data

# Cross-origin callers. Empty denies every browser origin, which is what the
# single-container deployment wants: the SPA is served same-origin.
# CORS_ALLOWED_ORIGINS=

# SSO via Authentik (porte). Setting OIDC_ISSUER makes CLIENT_ID, CLIENT_SECRET
# and REDIRECT_URL mandatory. SSO_ONLY=true disables password login and requires
# OIDC_ISSUER.
# SSO_ONLY=false
# OIDC_ISSUER=https://porte.facile.studio/application/o/mycelium/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://mycelium.facile.studio/api/auth/oidc/callback
# OIDC_SUCCESS_URL=https://mycelium.facile.studio/auth/callback

# Log shipping to Journal. Both must be set for anything to be shipped.
# JOURNAL_URL=https://journal.facile.studio/api
# JOURNAL_TOKEN=
